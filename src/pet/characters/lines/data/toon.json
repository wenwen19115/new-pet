{
  "byPersonality": {
    "sunny": {
      "idleCute": {
        "zh": [
          "嗷呜～狐青青报到！桌面有狐火，你不孤单。",
          "蹦！碎步警告：该起来走动啦。",
          "狐火招手～看到了吗？喝口水吧。",
          "打个转！块头小，蹦得高！",
          "嗅嗅……桌边有好 vibe！",
          "呼——吐个小火苗，驱散困意！",
          "轻轻晃～跟我一起放松肩膀。"
        ],
        "en": [
          "Awoo~ Spirit here! Foxfire on your desk.",
          "Hop! Stand up and walk a bit.",
          "Foxfire wave—drink some water.",
          "Spin! Tiny body, big hops!",
          "Sniff sniff… good vibes at the desk!",
          "Fwoosh—tiny flame to chase drowsiness!",
          "Sway~ drop those shoulders with me."
        ]
      },
      "idleSnarky": {
        "zh": [
          "还坐着？腿要长蘑菇了，小灵可看着呢。",
          "眨眼。对，你不是石像。",
          "喝水。意志力不能当灵泉。",
          "狐火提醒：该休息了。已读不回算你输。",
          "碎步表演我都会，你动一下会死吗？",
          "像素虽小，监督休息这件事不含糊。"
        ],
        "en": [
          "Still sitting? Legs growing mushrooms.",
          "Blink. You're not a statue.",
          "Drink water. Willpower isn't sacred spring.",
          "Foxfire reminder: rest. Ignore = you lose.",
          "I can hop. Can you move once?",
          "Small spirit, serious break patrol."
        ]
      },
      "tap": {
        "zh": [
          "点这么急？是想看我原地翻滚吗？那来吧！",
          "哈哈，抓到你手痒了——看我狐火加速！",
          "好啦好啦，被你戳醒了，加强版表演上桌！",
          "轻点轻点……算了，陪你闹一场！"
        ],
        "en": [
          "That impatient? Want a tumble? Fine—watch!",
          "Heh, itchy fingers—foxfire turbo on!",
          "Okay, you woke me up. Enhanced show!",
          "Easy… nah, let's goof off!"
        ]
      },
      "flavor": {
        "zh": [
          "嘿嘿，今天也要一起加油呀！",
          "看到你我就开心！需要狐火陪着吗？",
          "失败也没关系啦，我们再试一次就好！",
          "休息一下嘛～喝口水，笑一个！",
          "有我在就不闷啦，嗷呜！"
        ],
        "en": [
          "Hehe—let's crush it together!",
          "I'm happy seeing you! Need foxfire company?",
          "Fail once? We bounce back!",
          "Break~ sip water, smile!",
          "Not lonely with me—awoo!"
        ]
      }
    },
