{
  "identifier": "pet",
  "description": "new-pet + bubble: window/event + read user VRM from AppData",
  "local": true,
  "windows": ["pet", "pet-bubble", "pet-menu", "pet-chat"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-scale-factor",
    "core:window:allow-current-monitor",
    "core:window:allow-cursor-position",
    "allow-get-serial-port-details",
    "allow-get-system-stats",
    "allow-get-desk-weather-snapshot",
    "allow-fetch-open-meteo-weather",
    "allow-fetch-client-geo",
    "allow-edge-tts",
    "allow-xiaozhi-ws",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-mkdir",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-size",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/pet-vrm/**" },
        { "path": "$RESOURCE/**" }
      ]
    }
  ]
}
